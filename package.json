{
  "name": "@hobbs-og/design-system",
  "version": "0.1.0",
  "description": "Hobbs Design System – white-label token & component system",
  "type": "module",
  "scripts": {
    "build:tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "watch:tokens": "style-dictionary build --config style-dictionary.config.mjs --watch",
    "build": "npm run build:tokens",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.0",
    "typescript": "^5.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
