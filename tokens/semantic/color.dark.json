{
  "semantic-dark": {
    "color": {
      "text": {
        "primary":   { "$value": "{color.content.knockout}",   "$type": "color" },
        "secondary": { "$value": "#c9ccd1",                    "$type": "color" },
        "subtle":    { "$value": "#9ca3af",                    "$type": "color" },
        "disabled":  { "$value": "#6b7280",                    "$type": "color" },
        "inverse":   { "$value": "{color.content.headline}",   "$type": "color" },
        "link":      { "$value": "{color.brand.tertiary.300}", "$type": "color" },
        "link-hover":{ "$value": "{color.brand.tertiary.200}", "$type": "color" }
      },
      "surface": {
        "default":   { "$value": "#0f1117", "$type": "color" },
        "subtle":    { "$value": "#1a1d26", "$type": "color" },
        "inverse":   { "$value": "{color.background.default}", "$type": "color" },
        "brand":     { "$value": "{color.brand.primary.600}",  "$type": "color" },
        "overlay":   { "$value": "#00000099",                  "$type": "color" }
      },
      "border": {
        "default":   { "$value": "#2d3148", "$type": "color" },
        "strong":    { "$value": "#3d4260", "$type": "color" },
        "focus":     { "$value": "{color.brand.tertiary.400}", "$type": "color" },
        "brand":     { "$value": "{color.brand.primary.400}",  "$type": "color" }
      }
    }
  }
}
