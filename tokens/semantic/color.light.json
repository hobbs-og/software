{
  "semantic": {
    "color": {
      "brand": {
        "primary":          { "$value": "{color.brand.primary.500}", "$type": "color" },
        "primary-hover":    { "$value": "{color.brand.primary.600}", "$type": "color" },
        "primary-active":   { "$value": "{color.brand.primary.700}", "$type": "color" },
        "primary-subtle":   { "$value": "{color.brand.primary.50}",  "$type": "color" },
        "secondary":        { "$value": "{color.brand.secondary.500}", "$type": "color" },
        "secondary-hover":  { "$value": "{color.brand.secondary.600}", "$type": "color" },
        "tertiary":         { "$value": "{color.brand.tertiary.500}", "$type": "color" },
        "tertiary-hover":   { "$value": "{color.brand.tertiary.600}", "$type": "color" }
      },
      "text": {
        "primary":   { "$value": "{color.content.headline}", "$type": "color" },
        "secondary": { "$value": "{color.content.default}",  "$type": "color" },
        "subtle":    { "$value": "{color.content.subtle}",   "$type": "color" },
        "disabled":  { "$value": "{color.content.disabled}", "$type": "color" },
        "inverse":   { "$value": "{color.content.knockout}", "$type": "color" },
        "link":      { "$value": "{color.brand.tertiary.500}", "$type": "color" },
        "link-hover":{ "$value": "{color.brand.tertiary.600}", "$type": "color" }
      },
      "surface": {
        "default":   { "$value": "{color.background.default}", "$type": "color" },
        "subtle":    { "$value": "{color.background.subtle}",  "$type": "color" },
        "inverse":   { "$value": "{color.background.knockout}","$type": "color" },
        "brand":     { "$value": "{color.brand.primary.500}",  "$type": "color" },
        "overlay":   { "$value": "{color.background.overlay}", "$type": "color" }
      },
      "border": {
        "default":   { "$value": "{color.border.default}", "$type": "color" },
        "strong":    { "$value": "{color.border.strong}",  "$type": "color" },
        "focus":     { "$value": "{color.border.focus}",   "$type": "color" },
        "brand":     { "$value": "{color.brand.primary.500}", "$type": "color" }
      },
      "feedback": {
        "success":   { "$value": "{color.utility.success.default}", "$type": "color" },
        "warning":   { "$value": "{color.utility.warning.default}", "$type": "color" },
        "error":     { "$value": "{color.utility.error.default}",   "$type": "color" }
      }
    }
